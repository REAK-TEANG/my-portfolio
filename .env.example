# Copy this file to ".env" and fill it in. Restart `npm run dev` after changing it.
#
# Contact form endpoint (free options: Formspree, Web3Forms, Getform).
# Example with Formspree: https://formspree.io/f/xxxxxxxx
# If this is empty, the form opens the visitor's email app instead (still works).
VITE_FORM_ENDPOINT=
