# Copy this file to ".env" and fill it in. Restart `npm run dev` after changing it.
#
# Contact form: your Formspree form URL (formspree.io -> New form -> copy the URL).
# Example: https://formspree.io/f/xxxxxxxx
# If this is empty, the form opens the visitor's email app instead of sending.
#
# On Vercel add the SAME variable under Project -> Settings -> Environment Variables,
# then redeploy (Vite bakes VITE_* values in at build time).
VITE_FORM_ENDPOINT=
